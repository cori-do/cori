{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "@cori-do/client": ["./vendor/cori-client/index.ts"],
      "@cori-do/client/react": ["./vendor/cori-client/react.ts"]
    }
  },
  "include": ["src", "vendor"]
}
